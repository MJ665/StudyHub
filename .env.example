# GrindBuddy environment template. Copy to .env (repo root) and fill in.
# The real .env is gitignored — never commit secrets.




# --- Infrastructure ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
JWT_SECRET_KEY="change-me-to-a-64-char-random-hex"
ENVIRONMENT="development"           # development | production
DEBUG="True"

# --- Cloud APIs ---
GEMINI_API_KEY=""
RESEND_API_KEY=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# AI chat provider (chat on OpenRouter free model; embeddings stay on Gemini)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"

# --- App config (all have safe dev defaults in config.py; override in prod) ---
# Public web app URL — used to build links in emails & certificates.
FRONTEND_URL="https://grindbuddy.mj665.in"
# Email sender identities (must be verified domains in Resend).
RESEND_FROM_EMAIL="GrindBuddy L&D <noreply@email.mj665.in>"
SECURITY_FROM_EMAIL="GrindBuddy Security <security@email.mj665.in>"
CONTACT_EMAIL="contact.hackathonmj@gmail.com"
# AI model ids (change without touching code).
PRIMARY_AI_MODEL="gemini-2.5-flash"
SECONDARY_AI_MODEL="gemini-2.5-flash"
FAST_AI_MODEL="gemini-2.5-flash"
GEMINI_EMBED_MODEL="gemini-embedding-001"
# OpenRouter attribution header (not a secret).
OPENROUTER_REFERER="https://grindbuddy.mj665.in"

# --- Seed operator identities ---------------------------------------------
# Drive ensure_system_identity.py: enforced on every startup AND whenever the
# database is initialized from zero (scripts/reset_and_seed.py). Change these to
# reconfigure who the Platform Admin and the org's L&D Admin are.
APP_ADMIN_EMAIL="meet.jain563@gmail.com"      # Platform Admin (owns /platform)
APP_ADMIN_PASSWORD="change-me"
LD_ADMIN_EMAIL="contact.hackathonmj@gmail.com" # L&D Admin for the seed org
LD_ADMIN_PASSWORD="change-me"
SEED_ORG_NAME="Sigmoid HQ"
SEED_ORG_SLUG="sigmoid-hq"

# --- Production-only (validated when ENVIRONMENT=production) ---
S3_BUCKET_NAME=""
HMAC_KEY_SECRET="change-me-not-the-dev-default"
ALLOWED_ORIGINS='["https://your-frontend-domain"]'

# --- Google Play Store listing (documentation; set in Play Console UI) -------
# The store category is chosen in the Play Console, but kept here so it lives in
# one editable place. Change and re-sync google-playstore/store-listing.md.
PLAY_STORE_CATEGORY="Education"        # Education | Business | Productivity
PLAY_STORE_CONTACT_EMAIL="contact.hackathonmj@gmail.com"

# ── Theme (tri-theme system) ────────────────────────────────────────────────
# Global DEFAULT theme for the whole site (every user can switch in the sidebar;
# their choice persists per device). One of: navy-light | navy-dark | classic.
# Unset or "navy-light" is the default (white + navy). Exposed to the browser (build-time).
NEXT_PUBLIC_DEFAULT_THEME=navy-light
