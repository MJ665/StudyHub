# ============================================================================
# StudyBuddy Web (Next.js) — environment template
# ----------------------------------------------------------------------------
# Copy to `.env.local` for local dev, or set these in Vercel → Project →
# Settings → Environment Variables for production. Real env files are gitignored;
# this `.env.example` is the safe committed template (no real values).
#
# The frontend reaches the backend through a SAME-ORIGIN reverse proxy
# (next.config.ts rewrites /api/* → the backend), which keeps the auth cookie
# first-party (login/refresh work with no CORS setup).
# ============================================================================

# Backend origin the /api/* proxy forwards to. Optional — next.config.ts already
# defaults to https://studybuddy-api.mj665.in in production. Override only if the
# backend URL changes.
API_PROXY_ORIGIN=https://studybuddy-api.mj665.in

# ⚠️ DO NOT set NEXT_PUBLIC_API_BASE. Leaving it unset makes the client call the
# same-origin /api (which the proxy forwards). Setting it bypasses the proxy and
# breaks the HttpOnly refresh cookie.

# --- Theme (tri-theme system) ------------------------------------------------
# Global DEFAULT theme (every user can switch in the sidebar; choice persists per
# device). One of: navy-light | navy-dark | classic. Default is navy-light.
NEXT_PUBLIC_DEFAULT_THEME=navy-light

# --- Observability (Sentry) — OPTIONAL ---------------------------------------
# NEXT_PUBLIC_* values are exposed to the browser (a Sentry DSN is meant to be
# public). The AUTH TOKEN is a real secret — set it only in Vercel, never commit.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_RELEASE=studybuddy-web@1.0.0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2
NEXT_PUBLIC_SENTRY_REPLAY_SAMPLE_RATE=0.1
SENTRY_ORG=meet-w7
SENTRY_PROJECT=studybuddy
# NEVER commit a real token — set this in Vercel's env settings only.
SENTRY_AUTH_TOKEN=
