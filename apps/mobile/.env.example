# ============================================================================
# StudyBuddy mobile (Expo) — environment template
# ----------------------------------------------------------------------------
# Copy this file to `.env` in THIS folder (apps/mobile/.env) and fill it in.
# `.env` is gitignored — it is NEVER committed. This `.env.example` is the safe,
# committed template (no real values).
#
# WHERE EACH VALUE IS USED:
#   • Local `expo start` on your machine  → reads this apps/mobile/.env
#   • EAS cloud builds (eas build)         → read eas.json `env` (public values)
#                                            + EAS Environment Variables (secrets)
#   • Google Play Console                  → store listing / Data Safety (UI only)
#
# "EXPO_PUBLIC_*" values are BAKED INTO the shipped app, so they are NOT secret
# (anyone can read them from the APK). The only true secret here is
# SENTRY_AUTH_TOKEN (build-time only). Keep that out of git — set it as an EAS
# Environment Variable, not in this file, for cloud builds.
# ============================================================================

# --- Required: which web app the WebView loads -------------------------------
# Production is already set in eas.json for preview/production builds. Set this
# for LOCAL runs. For the Android emulator against a local web dev server, use
# http://10.0.2.2:3000  (10.0.2.2 = the host machine's localhost from the emulator).
EXPO_PUBLIC_WEB_URL=https://studybuddy.mj665.in

# The path the installed app opens to (auth-gated; → /login if signed out).
EXPO_PUBLIC_ENTRY_PATH=/dashboard

# --- EAS project id (from `eas init`) ----------------------------------------
# Not a secret (it's a UUID). Fill it in so push tokens + builds resolve. You can
# also leave it here and it will be read by app.config.ts.
EAS_PROJECT_ID=

# --- Firebase push (FCM) -----------------------------------------------------
# Download google-services.json from your Firebase Android app and place it at
# apps/mobile/google-services.json (that file is gitignored). This var just points
# at it; leave as the default path.
GOOGLE_SERVICES_JSON=./google-services.json

# --- Crash reporting (Sentry) — OPTIONAL -------------------------------------
# The app runs fine without these (Sentry simply no-ops). The DSN is public (it
# ships in the app); the AUTH TOKEN is a real secret used only to upload readable
# stack traces during the build.
#   • Local run: put the DSN here.
#   • EAS build: set EXPO_PUBLIC_SENTRY_DSN as an EAS Environment Variable, and
#     SENTRY_AUTH_TOKEN as a SECRET one (see apps/mobile/README.md).
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=production
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_ORG=meet-w7
SENTRY_PROJECT=studybuddy
# NEVER commit a real token. Leave blank here; set it as an EAS secret instead.
SENTRY_AUTH_TOKEN=
